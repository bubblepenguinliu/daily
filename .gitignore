# 环境
.venv/
venv/
__pycache__/
*.py[cod]

# 密钥（绝不入库）
.env

# 本地日志 / 临时文件
logs/
*.log
_probe*.py
_preview.png

# Pages 构建产物
_site/

# 旧版二进制状态文件（已迁移到 state/seen.jsonl）
state/*.sqlite
state/*.sqlite.migrated

# output/ 与 state/ 都入库：
#   output/          -> 每日日报，推到 GitHub 后可直接在线阅读 / 发布到 Pages
#   state/seen.jsonl -> 去重记录（JSONL + git union 合并，永不冲突），
#                       入库后本地和 CI 都能接着跑，不会重复推送旧内容
